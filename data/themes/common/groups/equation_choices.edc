/* Low-profile material switches; all activation remains native Elementary. */
group { name: "elm/check/base/default";
 min: 0 36;
 parts {
  part { name: "clip"; type: RECT; mouse_events: 0;
   description { state: "default" 0.0; color: 255 255 255 255; }
   description { state: "disabled" 0.0; inherit: "default" 0.0; color: 255 255 255 100; }
  }
  part { name: "hover"; type: RECT; mouse_events: 0; clip_to: "clip";
   description { state: "default" 0.0; color: 255 255 255 0; }
   description { state: "over" 0.0; inherit: "default" 0.0; color: RGB_ACCENT 12; }
   description { state: "pressed" 0.0; inherit: "default" 0.0; color: 0 0 0 35; }
  }
  part { name: "outline"; type: IMAGE; scale: 1; mouse_events: 0; clip_to: "clip";
   description { state: "default" 0.0; offset_scale: 1;
    min: 34 23; max: 34 23; align: 0 0.5;
    rel1.offset: 5 0; rel2.relative: 0 1; rel2.offset: 5 -1;
    image.normal: "equation_toggle.svg";
   }
   description { state: "checked" 0.0; inherit: "default" 0.0; image.normal: "equation_toggle_on.svg"; }
  }
  part { name: "elm.swallow.content"; type: SWALLOW; mouse_events: 0; clip_to: "clip";
   description { state: "default" 0.0; visible: 0; }
  }
  part { name: "elm.text"; type: TEXT; scale: 1; mouse_events: 0; clip_to: "clip";
   description { state: "default" 0.0; offset_scale: 1;
    rel1.offset: 48 8; rel2.offset: -9 -9; color: INK;
    text { font: "Sans"; size: 11; min: 1 1; align: 0 0.5; }
   }
  }
  part { name: "event"; type: RECT; ignore_flags: ON_HOLD; scale: 1;
   description { state: "default" 0.0; min: 0 36; color: 0 0 0 0; }
   description { state: "disabled" 0.0; inherit: "default" 0.0; visible: 0; }
  }
 }
 programs {
  program { signal: "mouse,clicked,1"; source: "event"; action: SIGNAL_EMIT "elm,action,check,toggle" "elm"; }
  program { signal: "elm,state,check,on"; source: "elm"; action: STATE_SET "checked" 0.0; target: "outline"; transition: DECELERATE .16; }
  program { signal: "elm,state,check,off"; source: "elm"; action: STATE_SET "default" 0.0; target: "outline"; transition: DECELERATE .16; }
  program { signal: "mouse,in"; source: "event"; action: STATE_SET "over" 0.0; target: "hover"; transition: DECELERATE .12; }
  program { signal: "mouse,out"; source: "event"; action: STATE_SET "default" 0.0; target: "hover"; transition: DECELERATE .12; }
  program { signal: "mouse,down,1"; source: "event"; action: STATE_SET "pressed" 0.0; target: "hover"; }
  program { signal: "mouse,up,1"; source: "event"; action: STATE_SET "over" 0.0; target: "hover"; transition: DECELERATE .12; }
  program { signal: "elm,action,focus_highlight,show"; source: "elm"; action: STATE_SET "over" 0.0; target: "hover"; }
  program { signal: "elm,action,focus_highlight,hide"; source: "elm"; action: STATE_SET "default" 0.0; target: "hover"; }
  program { signal: "elm,state,disabled"; source: "elm"; action: STATE_SET "disabled" 0.0; target: "clip"; target: "event"; }
  program { signal: "elm,state,enabled"; source: "elm"; action: STATE_SET "default" 0.0; target: "clip"; target: "event"; }
 }
}

/* Flat inset selectors; all activation remains native Elementary. */
group { name: "elm/radio/base/default";
 min: 0 36;
 parts {
  part { name: "clip"; type: RECT; mouse_events: 0;
   description { state: "default" 0.0; color: 255 255 255 255; }
   description { state: "disabled" 0.0; inherit: "default" 0.0; color: 255 255 255 100; }
  }
  part { name: "hover"; type: RECT; mouse_events: 0; clip_to: "clip";
   description { state: "default" 0.0; color: 255 255 255 0; }
   description { state: "over" 0.0; inherit: "default" 0.0; color: RGB_ACCENT 12; }
   description { state: "pressed" 0.0; inherit: "default" 0.0; color: 0 0 0 35; }
  }
  part { name: "halo"; type: IMAGE; mouse_events: 0; clip_to: "clip"; scale: 1;
   description { state: "default" 0.0; offset_scale: 1; rel.to: "outline";
    rel1.offset: -1 -1; rel2.offset: 1 1; image.normal: "equation_radio_hover.svg"; color: 255 255 255 0; }
   description { state: "over" 0.0; inherit: "default" 0.0;
    rel1.offset: -4 -4; rel2.offset: 4 4; color: 255 255 255 255; }
   description { state: "pressed" 0.0; inherit: "over" 0.0; rel1.offset: -1 -1; rel2.offset: 1 1; }
  }
  part { name: "outline"; type: IMAGE; scale: 1; mouse_events: 0; clip_to: "clip";
   description { state: "default" 0.0; offset_scale: 1;
    min: 23 23; max: 23 23; align: 0 0.5;
    rel1.offset: 5 0; rel2.relative: 0 1; rel2.offset: 5 -1;
    image.normal: "equation_radio.svg";
   }
   description { state: "checked" 0.0; inherit: "default" 0.0; image.normal: "equation_radio_on.svg"; }
  }
  part { name: "elm.swallow.content"; type: SWALLOW; mouse_events: 0; clip_to: "clip";
   description { state: "default" 0.0; visible: 0; }
  }
  part { name: "elm.text"; type: TEXT; scale: 1; mouse_events: 0; clip_to: "clip";
   description { state: "default" 0.0; offset_scale: 1;
    rel1.offset: 40 8; rel2.offset: -9 -9; color: INK;
    text { font: "Sans"; size: 11; min: 1 1; align: 0 0.5; }
   }
  }
  part { name: "event"; type: RECT; ignore_flags: ON_HOLD; scale: 1;
   description { state: "default" 0.0; min: 0 36; color: 0 0 0 0; }
   description { state: "disabled" 0.0; inherit: "default" 0.0; visible: 0; }
  }
 }
 programs {
  program { signal: "mouse,clicked,1"; source: "event"; action: SIGNAL_EMIT "elm,action,radio,toggle" "elm"; }
  program { signal: "elm,state,radio,on"; source: "elm"; action: STATE_SET "checked" 0.0; target: "outline"; transition: DECELERATE .16; }
  program { signal: "elm,state,radio,off"; source: "elm"; action: STATE_SET "default" 0.0; target: "outline"; transition: DECELERATE .16; }
  program { signal: "mouse,in"; source: "event"; action: STATE_SET "over" 0.0; target: "hover"; target: "halo"; transition: DECELERATE .20; }
  program { signal: "mouse,out"; source: "event"; action: STATE_SET "default" 0.0; target: "hover"; target: "halo"; transition: DECELERATE .20; }
  program { signal: "mouse,down,1"; source: "event"; action: STATE_SET "pressed" 0.0; target: "hover"; target: "halo"; }
  program { signal: "mouse,up,1"; source: "event"; action: STATE_SET "over" 0.0; target: "hover"; target: "halo"; transition: DECELERATE .20; }
  program { signal: "elm,action,focus_highlight,show"; source: "elm"; action: STATE_SET "over" 0.0; target: "hover"; target: "halo"; }
  program { signal: "elm,action,focus_highlight,hide"; source: "elm"; action: STATE_SET "default" 0.0; target: "hover"; target: "halo"; }
  program { signal: "elm,state,disabled"; source: "elm"; action: STATE_SET "disabled" 0.0; target: "clip"; target: "event"; }
  program { signal: "elm,state,enabled"; source: "elm"; action: STATE_SET "default" 0.0; target: "clip"; target: "event"; }
 }
}
