group { name: "elm/button/base/default";
 min: 27 27;
 #include "equation_button_script.edc"
 parts {
  part { name: "surface"; type: IMAGE; mouse_events: 0;
   scale: 1; description { offset_scale: 1; state: "default" 0.0; image.normal: "equation_key.svg"; image.border: 12 12 12 12; }
   description { offset_scale: 1; state: "over" 0.0; inherit: "default" 0.0; image.normal: "equation_key_hover.svg"; }
   description { offset_scale: 1; state: "pressed" 0.0; inherit: "default" 0.0; image.normal: "equation_key_pressed.svg"; }
   description { offset_scale: 1; state: "disabled" 0.0; inherit: "default" 0.0; color: 128 128 128 128; }
  }
  part { name: "border"; type: RECT; mouse_events: 0;
   scale: 1; description { offset_scale: 1; state: "default" 0.0; visible: 0; color: ACCENT; rel2 { relative: 0 1; offset: 2 -1; } }
   description { offset_scale: 1; state: "selected" 0.0; inherit: "default" 0.0; visible: 1; }
  }
  #include "equation_hover_parts.edc"
  part { name: "elm.swallow.content"; type: SWALLOW;
   scale: 1; description { offset_scale: 1; state: "default" 0.0; rel1.offset: 6 5; rel2.offset: -7 -5; }
  }
  part { name: "elm.text"; type: TEXT; scale: 1; mouse_events: 0;
   description { offset_scale: 1; state: "default" 0.0; rel1.offset: 9 6; rel2.offset: -10 -7; color: INK;
    text { font: "Sans"; size: 11; min: 1 1; ellipsis: -1; } }
   description { offset_scale: 1; state: "pressed" 0.0; inherit: "default" 0.0; rel1.offset: 9 7; rel2.offset: -10 -6; }
   description { offset_scale: 1; state: "disabled" 0.0; inherit: "default" 0.0; color: EDGE; }
  }
  part { name: "hover_light"; type: RECT; scale: 1; mouse_events: 0;
   description { state: "default" 0.0; offset_scale: 1; color: RGB_ACCENT 0;
    rel1 { relative: .5 1; offset: 0 -4; } rel2 { relative: .5 1; offset: -1 -4; } }
   description { state: "over" 0.0; inherit: "default" 0.0; color: RGB_ACCENT 180;
    rel1.relative: .2 1; rel2.relative: .8 1; }
  }
  part { name: "event"; type: RECT; ignore_flags: ON_HOLD;
   scale: 1; description { offset_scale: 1; state: "default" 0.0; min: 36 30; color: 0 0 0 0; }
   description { offset_scale: 1; state: "disabled" 0.0; inherit: "default" 0.0; visible: 0; }
  }
 }
 programs {
  #include "equation_button_programs.edc"
  #include "equation_hover_programs.edc"

  program { signal: "equation,selected,on"; source: "equation"; action: STATE_SET "selected" 0.0; target: "border"; }
  program { signal: "equation,selected,off"; source: "equation"; action: STATE_SET "default" 0.0; target: "border"; }
  program { signal: "equation,hover,on"; source: "equation"; action: STATE_SET "over" 0.0; target: "hover_light"; transition: DECELERATE .20; }
  program { signal: "equation,hover,off"; source: "equation"; action: STATE_SET "default" 0.0; target: "hover_light"; transition: DECELERATE .20; }
 }
}
group { name: "elm/button/base/equation/window";
 min: 28 28;
 #include "equation_button_script.edc"
 parts {
  part { name: "surface"; type: RECT; mouse_events: 0; scale: 1;
   description { state: "default" 0.0; offset_scale: 1; rel1.offset: 2 2; rel2.offset: -3 -3; color: 0 0 0 0; }
   description { state: "over" 0.0; inherit: "default" 0.0; color: EDGE; }
   description { state: "pressed" 0.0; inherit: "default" 0.0; color: BG; }
   description { state: "disabled" 0.0; inherit: "default" 0.0; color: 0 0 0 0; }
  }
  #include "equation_hover_parts.edc"
  part { name: "elm.swallow.content"; type: SWALLOW; scale: 1;
   description { state: "default" 0.0; offset_scale: 1; rel1.offset: 6 6; rel2.offset: -7 -7; }
  }
  part { name: "elm.text"; type: TEXT; scale: 1; mouse_events: 0;
   description { state: "default" 0.0; color: INK; text { font: "Sans"; size: 13; min: 1 1; } }
   description { state: "pressed" 0.0; inherit: "default" 0.0; }
   description { state: "disabled" 0.0; inherit: "default" 0.0; color: MUTE; }
  }
  part { name: "event"; type: RECT; ignore_flags: ON_HOLD; scale: 1;
   description { state: "default" 0.0; min: 28 28; color: 0 0 0 0; }
   description { state: "disabled" 0.0; inherit: "default" 0.0; visible: 0; }
  }
 }
 programs {
  #include "equation_button_programs.edc"
  #include "equation_hover_programs.edc"
 }
}
/* These glyphs have smaller ink bounds than the menu and maximize symbols. */
group { name: "elm/button/base/equation/window-minimize";
 inherit: "elm/button/base/equation/window";
 parts { part { name: "elm.text";
   description { state: "default" 0.0; text.size: 20; }
 } }
}
group { name: "elm/button/base/equation/window-close";
 inherit: "elm/button/base/equation/window";
 parts { part { name: "surface";
   description { state: "over" 0.0; color: 190 54 68 180; }
   description { state: "pressed" 0.0; color: 160 36 48 255; }
 }
 part { name: "elm.text";
   description { state: "default" 0.0; text.size: 20; }
 } }
}
group { name: "elm/button/base/equation/function";
 inherit: "elm/button/base/default";
 parts {
  part { name: "event"; description { state: "default" 0.0; min: 36 28; } }
  part { name: "elm.text"; description { state: "default" 0.0; text.size: 10; rel1.offset: 7 6; rel2.offset: -8 -7; } }
 }
}
group { name: "elm/button/base/equation/operator";
 inherit: "elm/button/base/default";
 parts { part { name: "elm.text"; description { state: "default" 0.0; color: ACCENT; text.size: 14; } } }
}
group { name: "elm/button/base/equation/equals";
 inherit: "elm/button/base/default";
 parts {
  part { name: "surface"; description { state: "default" 0.0; image.normal: "equation_equals.svg"; }
   description { state: "over" 0.0; image.normal: "equation_equals.svg"; color: 235 255 255 255; }
   description { state: "pressed" 0.0; image.normal: "equation_equals.svg"; color: 180 190 190 255; }
  }
  part { name: "elm.text"; description { state: "default" 0.0; color: BG; text.font: "Sans:style=Bold"; text.size: 16; } }
 }
}
group { name: "elm/button/base/equation/copy";
 inherit: "elm/button/base/default";
 parts {
  part { name: "elm.swallow.content"; description { state: "default" 0.0; rel1.offset: 6 6; rel2.offset: -7 -7; } }
 }
}
