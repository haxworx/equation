 programs {
  #include "equation_motion_programs.edc"
#if LAB
  program { signal: "equation,digits"; source: "equation";
   action: STATE_SET "digits" 0.0; target: "equation.value"; }
  program { signal: "equation,digits"; source: "equation";
   action: STATE_SET "default" 0.0; target: "digit_clip"; }
  program { signal: "equation,compact"; source: "equation";
   action: STATE_SET "compact" 0.0; target: "digit_clip"; }
  program { signal: "equation,compact"; source: "equation";
   action: STATE_SET "default" 0.0; target: "equation.value"; }
#endif
 }
