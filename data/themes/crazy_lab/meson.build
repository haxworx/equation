equation_themes += custom_target(
  'equation_crazy_lab',
  input : 'equation_crazy_lab.edc',
  output : 'equation_crazy_lab.edj',
  depfile : '@BASENAME@.d',
  depend_files : files(
    'images/equation_radio_hover.svg',
    'images/equation_radio_on.svg',
    'images/equation_toggle.svg',
    'images/equation_toggle_on.svg',
    'images/equation_equals.svg',
    'images/equation_copy.svg',
    'images/equation_check.svg',
    'images/equation_field.svg',
    'images/equation_motion.svg',
    '../common/images/equation_window_shadow.png',
    'images/equation_images.edc',
    'images/equation_radio.svg',
    'images/equation_rule.svg',
    'images/equation_body.svg',
    'images/equation_key.svg',
    'images/equation_key_hover.svg',
    'images/equation_key_pressed.svg',
    'images/equation_display.svg',
    'images/equation_tube.svg',
  ),
  command : [
    equation_edje_cc,
    '-deps',
    '@DEPFILE@',
    '-id',
    meson.current_source_dir() / 'images',
    '-id',
    meson.current_source_dir() / '../common/images',
    '@INPUT@',
    '@OUTPUT@',
  ],
  env : ['EINA_LOG_LEVEL=0', 'ECORE_NO_SYSTEM_MODULES=1'],
  build_by_default : true,
  install : true,
  install_mode : 'rw-r--r--',
  install_dir : equation_theme_install_dir,
)
